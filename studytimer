
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Flip Study Timer</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* 3D Flip Animation CSS */
    .perspective { perspective: 1000px; }
    .flip-top { transform-origin: bottom; backface-visibility: hidden; }
    .flip-bottom { transform-origin: top; backface-visibility: hidden; }
    .rotate-x-90 { transform: rotateX(90deg); }

    .animate-top { animation: flipTop 0.25s ease-in forwards; }
    .animate-bottom { animation: flipBottom 0.25s ease-out 0.25s forwards; }

    @keyframes flipTop {
      0% { transform: rotateX(0deg); }
      100% { transform: rotateX(-90deg); }
    }
    @keyframes flipBottom {
      0% { transform: rotateX(90deg); }
      100% { transform: rotateX(0deg); }
    }

    /* Hide scrollbar for chart but keep functionality */
    .custom-scrollbar::-webkit-scrollbar {
      height: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #171717; 
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #404040; 
      border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #525252; 
    }

    /* Base Body Setup */
    body {
      margin: 0;
      background-color: #000;
      color: #fff;
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      overflow: hidden;
      user-select: none;
      -webkit-user-select: none;
    }
  </style>
</head>
<body>

  <!-- Portrait Warning Overlay -->
  <div class="portrait:flex landscape:hidden fixed inset-0 z-50 bg-neutral-950 text-white items-center justify-center flex-col text-center p-6">
    <svg class="w-16 h-16 mb-6 text-neutral-400 animate-[spin_3s_linear_infinite]" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
    <h2 class="text-3xl font-bold mb-2">Rotate Device</h2>
    <p class="text-neutral-500 max-w-xs">Please rotate your device to landscape mode for the best study timer experience.</p>
  </div>

  <!-- Main Landscape UI -->
  <div class="portrait:hidden flex flex-col items-center justify-center w-full h-screen p-8 relative">
    
    <!-- Top Controls -->
    <div class="absolute top-6 right-6 flex gap-4">
      <button id="btn-fullscreen" class="p-3 rounded-full bg-neutral-900/50 hover:bg-neutral-800 text-neutral-400 transition-colors">
        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
      </button>
      <button id="btn-chart" class="p-3 rounded-full bg-neutral-900/50 hover:bg-neutral-800 text-neutral-400 transition-colors">
        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
      </button>
      <button id="btn-password" class="p-3 rounded-full bg-neutral-900/50 hover:bg-neutral-800 text-neutral-400 transition-colors">
        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
      </button>
    </div>

    <!-- Flip Clock Container -->
    <div class="flex items-center gap-4 md:gap-8 mb-12">
      <!-- Hours -->
      <div id="digit-hours" data-value="00" class="relative w-24 h-36 md:w-36 md:h-52 bg-[#121212] rounded-2xl shadow-2xl flex flex-col perspective text-[#f0f0f0] font-mono border border-neutral-800/80">
        <div class="absolute inset-x-0 top-0 h-1/2 bg-[#0a0a0a] rounded-t-2xl overflow-hidden flex justify-center items-end border-b border-black z-0">
          <span class="text-6xl md:text-8xl font-bold translate-y-[50%] tracking-tighter next-val">00</span>
        </div>
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-[#121212] rounded-b-2xl overflow-hidden flex justify-center items-start z-0">
          <span class="text-6xl md:text-8xl font-bold -translate-y-[50%] tracking-tighter current-val">00</span>
        </div>
        <div class="absolute inset-x-0 top-0 h-1/2 bg-[#121212] rounded-t-2xl overflow-hidden flex justify-center items-end border-b border-black flip-top z-10">
          <span class="text-6xl md:text-8xl font-bold translate-y-[50%] tracking-tighter current-val">00</span>
        </div>
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-[#0a0a0a] rounded-b-2xl overflow-hidden flex justify-center items-start flip-bottom z-20 rotate-x-90">
          <span class="text-6xl md:text-8xl font-bold -translate-y-[50%] tracking-tighter next-val">00</span>
        </div>
        <div class="absolute inset-x-0 top-1/2 h-[2px] bg-black/80 z-30 transform -translate-y-1/2 shadow-[0_1px_2px_rgba(255,255,255,0.1)]"></div>
      </div>

      <div class="text-4xl md:text-6xl font-bold text-neutral-600 mb-2 animate-pulse">:</div>

      <!-- Minutes -->
      <div id="digit-minutes" data-value="00" class="relative w-24 h-36 md:w-36 md:h-52 bg-[#121212] rounded-2xl shadow-2xl flex flex-col perspective text-[#f0f0f0] font-mono border border-neutral-800/80">
        <div class="absolute inset-x-0 top-0 h-1/2 bg-[#0a0a0a] rounded-t-2xl overflow-hidden flex justify-center items-end border-b border-black z-0">
          <span class="text-6xl md:text-8xl font-bold translate-y-[50%] tracking-tighter next-val">00</span>
        </div>
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-[#121212] rounded-b-2xl overflow-hidden flex justify-center items-start z-0">
          <span class="text-6xl md:text-8xl font-bold -translate-y-[50%] tracking-tighter current-val">00</span>
        </div>
        <div class="absolute inset-x-0 top-0 h-1/2 bg-[#121212] rounded-t-2xl overflow-hidden flex justify-center items-end border-b border-black flip-top z-10">
          <span class="text-6xl md:text-8xl font-bold translate-y-[50%] tracking-tighter current-val">00</span>
        </div>
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-[#0a0a0a] rounded-b-2xl overflow-hidden flex justify-center items-start flip-bottom z-20 rotate-x-90">
          <span class="text-6xl md:text-8xl font-bold -translate-y-[50%] tracking-tighter next-val">00</span>
        </div>
        <div class="absolute inset-x-0 top-1/2 h-[2px] bg-black/80 z-30 transform -translate-y-1/2 shadow-[0_1px_2px_rgba(255,255,255,0.1)]"></div>
      </div>

      <div class="text-4xl md:text-6xl font-bold text-neutral-600 mb-2 animate-pulse">:</div>

      <!-- Seconds -->
      <div id="digit-seconds" data-value="00" class="relative w-24 h-36 md:w-36 md:h-52 bg-[#121212] rounded-2xl shadow-2xl flex flex-col perspective text-[#f0f0f0] font-mono border border-neutral-800/80">
        <div class="absolute inset-x-0 top-0 h-1/2 bg-[#0a0a0a] rounded-t-2xl overflow-hidden flex justify-center items-end border-b border-black z-0">
          <span class="text-6xl md:text-8xl font-bold translate-y-[50%] tracking-tighter next-val">00</span>
        </div>
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-[#121212] rounded-b-2xl overflow-hidden flex justify-center items-start z-0">
          <span class="text-6xl md:text-8xl font-bold -translate-y-[50%] tracking-tighter current-val">00</span>
        </div>
        <div class="absolute inset-x-0 top-0 h-1/2 bg-[#121212] rounded-t-2xl overflow-hidden flex justify-center items-end border-b border-black flip-top z-10">
          <span class="text-6xl md:text-8xl font-bold translate-y-[50%] tracking-tighter current-val">00</span>
        </div>
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-[#0a0a0a] rounded-b-2xl overflow-hidden flex justify-center items-start flip-bottom z-20 rotate-x-90">
          <span class="text-6xl md:text-8xl font-bold -translate-y-[50%] tracking-tighter next-val">00</span>
        </div>
        <div class="absolute inset-x-0 top-1/2 h-[2px] bg-black/80 z-30 transform -translate-y-1/2 shadow-[0_1px_2px_rgba(255,255,255,0.1)]"></div>
      </div>
    </div>

    <!-- Play/Pause Button -->
    <button id="toggleBtn" class="group relative flex items-center justify-center w-24 h-24 md:w-28 md:h-28 rounded-full shadow-2xl transition-all duration-300 transform hover:scale-105 active:scale-95 bg-white text-black hover:bg-neutral-200">
      <svg id="icon-play" class="w-10 h-10 md:w-12 md:h-12 ml-2" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
      <svg id="icon-pause" class="w-10 h-10 md:w-12 md:h-12 hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
    </button>

  </div>

  <!-- Chart Modal -->
  <div id="chartModal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-sm hidden items-center justify-center p-6">
    <div class="bg-neutral-900 w-full max-w-3xl rounded-3xl p-8 border border-neutral-800 shadow-2xl relative">
      <button id="btn-close-chart" class="absolute top-6 right-6 text-neutral-400 hover:text-white">
        <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
        <svg class="w-6 h-6 text-indigo-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
        Monthly Study Overview
      </h2>
      
      <div id="chartContainer" class="h-64 flex items-end gap-2 overflow-x-auto pb-4 custom-scrollbar">
        <!-- Bars injected via JS -->
      </div>
    </div>
  </div>

  <!-- Password Modal -->
  <div id="passwordModal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-sm hidden items-center justify-center p-6">
    <div class="bg-neutral-900 w-full max-w-md rounded-3xl p-8 border border-neutral-800 shadow-2xl relative">
      <button id="btn-close-password" class="absolute top-6 right-6 text-neutral-400 hover:text-white">
        <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      
      <div class="flex flex-col items-center text-center">
        <div class="w-16 h-16 bg-neutral-800 rounded-full flex items-center justify-center mb-6">
          <svg class="w-8 h-8 text-rose-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        </div>
        <h2 class="text-2xl font-bold mb-2">Secure Restart</h2>
        <p id="pinPrompt" class="text-neutral-400 mb-8"></p>

        <form id="pinForm" class="w-full">
          <input
            type="password"
            id="pinInput"
            inputmode="numeric"
            pattern="[0-9]*"
            maxlength="8"
            class="w-full bg-neutral-950 border border-neutral-800 rounded-xl px-6 py-4 text-center text-2xl tracking-[0.5em] text-white focus:outline-none focus:border-rose-500 transition-colors mb-4"
          />
          <p id="pinError" class="text-rose-400 text-sm mb-4 hidden"></p>
          
          <button type="submit" id="pinSubmitBtn" class="w-full bg-white text-black font-bold text-lg rounded-xl py-4 hover:bg-neutral-200 transition-colors active:scale-[0.98]">
            Reset Timer
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    // --- State Variables ---
    let seconds = 0;
    let isRunning = false;
    let wakeLock = null;
    let timerInterval = null;
    let historyData = {};

    // --- Initialization ---
    function initApp() {
      const storedStr = localStorage.getItem('studyTimer');
      let stored = storedStr ? JSON.parse(storedStr) : {};
      
      const today = new Date().toISOString().split('T')[0];
      historyData = stored.history || {};

      if (stored.lastDate === today) {
        seconds = stored.todayTime || 0;
      } else {
        if (stored.lastDate) {
          historyData[stored.lastDate] = stored.todayTime || 0;
        }
        stored.lastDate = today;
        stored.todayTime = 0;
        stored.history = historyData;
        localStorage.setItem('studyTimer', JSON.stringify(stored));
        seconds = 0;
      }
      renderTime(true); 
    }

    // --- 3D Flip Clock Logic ---
    function updateDigit(id, newValue, initialRender = false) {
      const container = document.getElementById(id);
      const valStr = String(newValue).padStart(2, '0');
      const currentVal = container.getAttribute('data-value');

      if (currentVal === valStr && !initialRender) return;

      const nextNodes = container.querySelectorAll('.next-val');
      const currentNodes = container.querySelectorAll('.current-val');
      const flipTop = container.querySelector('.flip-top');
      const flipBottom = container.querySelector('.flip-bottom');

      if (initialRender) {
        nextNodes.forEach(n => n.innerText = valStr);
        currentNodes.forEach(n => n.innerText = valStr);
        container.setAttribute('data-value', valStr);
        return;
      }

      nextNodes.forEach(n => n.innerText = valStr);
      flipTop.classList.add('animate-top');
      flipBottom.classList.add('animate-bottom');

      setTimeout(() => {
        currentNodes.forEach(n => n.innerText = valStr);
        flipTop.classList.remove('animate-top');
        flipBottom.classList.remove('animate-bottom');
        container.setAttribute('data-value', valStr);
      }, 500); 
    }

    function renderTime(initial = false) {
      const h = Math.floor(seconds / 3600);
      const m = Math.floor((seconds % 3600) / 60);
      const s = seconds % 60;

      updateDigit('digit-hours', h, initial);
      updateDigit('digit-minutes', m, initial);
      updateDigit('digit-seconds', s, initial);
    }

    // --- Timer Logic ---
    function saveTick() {
      const today = new Date().toISOString().split('T')[0];
      const storedStr = localStorage.getItem('studyTimer');
      let stored = storedStr ? JSON.parse(storedStr) : {};

      if (stored.lastDate && stored.lastDate !== today) {
        stored.history = stored.history || {};
        stored.history[stored.lastDate] = stored.todayTime;
        stored.lastDate = today;
        stored.todayTime = 0;
        historyData = stored.history;
        seconds = 0;
      } else {
        stored.todayTime = (stored.todayTime || 0) + 1;
        stored.lastDate = today;
        seconds = stored.todayTime;
      }
      
      localStorage.setItem('studyTimer', JSON.stringify(stored));
      renderTime();
    }

    // --- Controls & APIs ---
    async function requestWakeLock() {
      try {
        if ('wakeLock' in navigator) {
          wakeLock = await navigator.wakeLock.request('screen');
        }
      } catch (err) {
        console.log('Wake Lock denied');
      }
    }

    function releaseWakeLock() {
      if (wakeLock !== null) {
        wakeLock.release().then(() => { wakeLock = null; });
      }
    }

    function toggleTimer() {
      const btn = document.getElementById('toggleBtn');
      const iconPlay = document.getElementById('icon-play');
      const iconPause = document.getElementById('icon-pause');

      if (!isRunning) {
        isRunning = true;
        requestWakeLock();
        timerInterval = setInterval(saveTick, 1000);
        
        btn.classList.remove('bg-white', 'text-black', 'hover:bg-neutral-200');
        btn.classList.add('bg-neutral-800', 'hover:bg-neutral-700', 'text-white');
        iconPlay.classList.add('hidden');
        iconPause.classList.remove('hidden');
      } else {
        pauseTimer();
      }
    }

    function pauseTimer() {
      isRunning = false;
      releaseWakeLock();
      clearInterval(timerInterval);
      
      const btn = document.getElementById('toggleBtn');
      const iconPlay = document.getElementById('icon-play');
      const iconPause = document.getElementById('icon-pause');

      btn.classList.add('bg-white', 'text-black', 'hover:bg-neutral-200');
      btn.classList.remove('bg-neutral-800', 'hover:bg-neutral-700', 'text-white');
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
    }

    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(err => console.log(err));
      } else {
        if (document.exitFullscreen) document.exitFullscreen();
      }
    }

    // --- Chart Modal ---
    function openChartModal() {
      const modal = document.getElementById('chartModal');
      const container = document.getElementById('chartContainer');
      modal.classList.remove('hidden');
      modal.classList.add('flex');

      const chartDays = Object.keys(historyData).sort().slice(-30);
      const maxTime = chartDays.length ? Math.max(...chartDays.map(d => historyData[d])) : 1;

      if (chartDays.length === 0) {
        container.innerHTML = `<div class="w-full h-full flex items-center justify-center text-neutral-500">No data available yet</div>`;
        return;
      }

      container.innerHTML = chartDays.map(date => {
        const time = historyData[date];
        const heightPercent = Math.max((time / maxTime) * 100, 2);
        const dateObj = new Date(date);
        const displayDate = `${dateObj.getDate()}/${dateObj.getMonth() + 1}`;
        const hrs = Math.floor(time / 3600);
        const mins = Math.floor((time % 3600) / 60);

        return `
          <div class="flex flex-col items-center flex-shrink-0 w-12 group">
            <div class="w-full bg-neutral-800 rounded-t-md relative flex items-end justify-center group-hover:bg-neutral-700 transition-colors h-48">
              <div class="w-full bg-indigo-500 rounded-t-md transition-all duration-500" style="height: ${heightPercent}%"></div>
              <div class="absolute -top-10 opacity-0 group-hover:opacity-100 transition-opacity bg-black text-xs py-1 px-2 rounded whitespace-nowrap z-10 pointer-events-none">
                ${hrs}h ${mins}m
              </div>
            </div>
            <span class="text-xs text-neutral-500 mt-2">${displayDate}</span>
          </div>
        `;
      }).join('');
    }

    function closeChartModal() {
      const modal = document.getElementById('chartModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // --- Password Modal ---
    function openPasswordModal() {
      const modal = document.getElementById('passwordModal');
      const input = document.getElementById('pinInput');
      const prompt = document.getElementById('pinPrompt');
      const btn = document.getElementById('pinSubmitBtn');
      const error = document.getElementById('pinError');
      
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      error.classList.add('hidden');
      input.value = '';
      
      const savedPin = localStorage.getItem('timerPin');
      if (!savedPin) {
        prompt.innerText = "Create a 4-digit PIN to secure your timer resets.";
        input.placeholder = "Set new PIN";
        btn.innerText = "Set PIN & Reset";
      } else {
        prompt.innerText = "Enter your PIN to reset today's timer.";
        input.placeholder = "Enter PIN";
        btn.innerText = "Reset Timer";
      }
      setTimeout(() => input.focus(), 100);
    }

    function closePasswordModal() {
      const modal = document.getElementById('passwordModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function handleRestartSubmit(e) {
      e.preventDefault();
      const inputVal = document.getElementById('pinInput').value;
      const error = document.getElementById('pinError');
      const savedPin = localStorage.getItem('timerPin');

      error.classList.add('hidden');

      if (!savedPin) {
        if (inputVal.length >= 4) {
          localStorage.setItem('timerPin', inputVal);
          resetData();
        } else {
          error.innerText = "PIN must be at least 4 digits";
          error.classList.remove('hidden');
        }
      } else {
        if (inputVal === savedPin) {
          resetData();
        } else {
          error.innerText = "Incorrect PIN";
          error.classList.remove('hidden');
        }
      }
    }

    function resetData() {
      pauseTimer();
      seconds = 0;
      
      const storedStr = localStorage.getItem('studyTimer');
      let stored = storedStr ? JSON.parse(storedStr) : {};
      stored.todayTime = 0;
      localStorage.setItem('studyTimer', JSON.stringify(stored));
      
      renderTime(true);
      closePasswordModal();
    }

    // --- Event Listeners Setup ---
    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('btn-fullscreen').addEventListener('click', toggleFullscreen);
      document.getElementById('btn-chart').addEventListener('click', openChartModal);
      document.getElementById('btn-password').addEventListener('click', openPasswordModal);
      document.getElementById('toggleBtn').addEventListener('click', toggleTimer);
      
      document.getElementById('btn-close-chart').addEventListener('click', closeChartModal);
      document.getElementById('btn-close-password').addEventListener('click', closePasswordModal);
      
      document.getElementById('pinForm').addEventListener('submit', handleRestartSubmit);

      // Pause on sleep / tab switch
      document.addEventListener('visibilitychange', () => {
        if (document.hidden && isRunning) {
          pauseTimer();
        }
      });

      // Boot App
      initApp();
    });
  </script>
</body>
</html>



